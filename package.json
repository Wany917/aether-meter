{
  "name": "aether-meter",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/overlay dev",
    "dev:demo": "bun run --cwd apps/overlay dev:demo",
    "build": "bun run --cwd apps/overlay build",
    "typecheck": "bun run --cwd apps/overlay typecheck",
    "bindings": "cargo test -p aether --lib export_bindings",
    "test": "cargo test --workspace && bun run typecheck",
    "sync:gamedata": "bun run scripts/sync-gamedata.ts",
    "sync:pets": "bun run scripts/sync-pets.ts",
    "probe": "cargo run -q -p aether-engine --bin aether-probe --"
  }
}
