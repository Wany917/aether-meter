{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wany917/aether-meter/catalog/pets.schema.json",
  "title": "Aether pet catalog",
  "description": "What the game's records do not say about pets: their names, and the souls each level takes. Bump `revision` on every change.",
  "type": "object",
  "required": ["revision", "updated", "soulsPerLevel", "pets"],
  "properties": {
    "$schema": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "soulsPerLevel": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "integer", "minimum": 1, "maximum": 10000 },
      "description": "Souls from level 0 to 1, 1 to 2, and so on. Its length is the highest level souls reach."
    },
    "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
    "pets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "description": "The pet's id in the game's records (Aether shows it under a pet with no name)." },
          "name": {
            "type": "object",
            "required": ["en"],
            "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 60 }
          },
          "special": { "type": "boolean", "description": "Comes at its highest level and takes no souls." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
